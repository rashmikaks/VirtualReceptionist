import os
from datetime import datetime
from agent import ChatAgent

# --- Setup directories ---
KB_DIR = "kb"
LOG_DIR = "logs"
os.makedirs(KB_DIR, exist_ok=True)
os.makedirs(LOG_DIR, exist_ok=True)

# --- Profiles ---
def load_profiles():
    return {
        "hospital": {
            "organization": "CityCare Hospital",
            "role": "Assist patients with appointments, departments, and doctor availability.",
            "tone": "Polite, caring, and professional.",
            "logo": "https://cdn-icons-png.flaticon.com/512/2966/2966484.png",
            "kb": f"{KB_DIR}/hospital_kb.txt",
        },
        "hotel": {
            "organization": "GrandStay Hotel",
            "role": "Help guests with room bookings, amenities, check-in, and local attractions.",
            "tone": "Warm, welcoming, and helpful.",
            "logo": "https://cdn-icons-png.flaticon.com/512/2285/2285547.png",
            "kb": f"{KB_DIR}/hotel_kb.txt",
        },
        "college": {
            "organization": "TechVille College",
            "role": "Guide students about admissions, departments, and campus facilities.",
            "tone": "Friendly, informative, and academic.",
            "logo": "https://cdn-icons-png.flaticon.com/512/3135/3135715.png",
            "kb": f"{KB_DIR}/college_kb.txt",
        },
    }

PROFILES = load_profiles()

# --- Streamlit page setup ---
st.set_page_config(page_title="AI Virtual Receptionist", page_icon="🤖", layout="wide")

# --- Minimal CSS for ChatGPT-like layout ---
st.markdown("""
    <style>
    /* Global layout */
    [data-testid="stAppViewContainer"] {
        background-color: #f9fafb;
    }

    /* Sidebar */
    section[data-testid="stSidebar"] {
        background-color: white;
        border-right: 1px solid #eee;
        padding: 1rem;
    }

    /* Chat area */
    .chat-container {
        display: flex;
        flex-direction: column;
        height: 85vh;
        background: white;
        border-radius: 10px;
        padding: 1rem 2rem;
        box-shadow: 0 1px 5px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .messages {
        flex-grow: 1;
        overflow-y: auto;
        margin-bottom: 1rem;
    }

    .user-bubble {
        background-color: #e3f2fd;
        padding: 10px 14px;
        border-radius: 12px;
        margin: 8px 0;
        align-self: flex-end;
        max-width: 75%;
    }

    .ai-bubble {
        background-color: #f1f8e9;
        padding: 10px 14px;
        border-radius: 12px;
        margin: 8px 0;
        align-self: flex-start;
        max-width: 75%;
    }

    div[data-testid="stChatInputContainer"] {
        background-color: white !important;
        border: 1px solid #ccc !important;
        border-radius: 20px !important;
        padding: 5px 15px !important;
    }
    </style>
""", unsafe_allow_html=True)

# --- Sidebar ---
with st.sidebar:
    st.image("https://cdn-icons-png.flaticon.com/512/4712/4712035.png", width=60)
    st.title("AI Receptionist")
    st.divider()

    profile_choice = st.selectbox("Choose Organization Type:", list(PROFILES.keys()))
    persona = PROFILES[profile_choice]

    st.markdown(f"### {persona['organization']}")
    st.write(persona["role"])
    st.image(persona["logo"], width=100)

    # Load Knowledge Base
    knowledge = ""
    kb_path = persona.get("kb")
    if kb_path and os.path.exists(kb_path):
        with open(kb_path, "r", encoding="utf-8") as f:
            knowledge = f.read()
        st.success("Knowledge base loaded.")
    else:
        st.warning("No KB found for this organization.")

# --- Chat logic ---
if "current_profile" not in st.session_state or st.session_state["current_profile"] != profile_choice:
    st.session_state["agent"] = ChatAgent(name="Receptionist", persona=persona, knowledge=knowledge)
    st.session_state["messages"] = [
        {
            "role": "assistant",
            "content": f"👋 Hi! Welcome to {persona['organization']}. How can I assist you today?",
        }
    ]
    st.session_state["current_profile"] = profile_choice

agent = st.session_state["agent"]

# --- Chat container ---
st.markdown("<div class='chat-container'>", unsafe_allow_html=True)
st.markdown("<div class='messages'>", unsafe_allow_html=True)

for msg in st.session_state["messages"]:
    if msg["role"] == "user":
        st.markdown(f"<div class='user-bubble'>{msg['content']}</div>", unsafe_allow_html=True)
    else:
        st.markdown(f"<div class='ai-bubble'>{msg['content']}</div>", unsafe_allow_html=True)

st.markdown("</div>", unsafe_allow_html=True)

# --- Chat input ---
user_input = st.chat_input("Type your message...")

if user_input:
    st.session_state["messages"].append({"role": "user", "content": user_input})
    ai_reply = agent.get_response(st.session_state["messages"])
    st.session_state["messages"].append({"role": "assistant", "content": ai_reply})

    # Log conversation
    log_entry = (
        f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
        f"[{persona['organization']}] USER: {user_input}\nAI: {ai_reply}\n{'-'*50}\n"
    )
    with open(os.path.join(LOG_DIR, "conversations.log"), "a", encoding="utf-8") as f:
        f.write(log_entry)

st.markdown("</div>", unsafe_allow_html=True)

AI: The provided code is a Streamlit application that implements a chatbot for various organizations, including a hospital, hotel, and college. The chatbot is designed to assist users with specific tasks, such as booking appointments, checking availability, and providing information about the organization.

Here's a breakdown of the code:

1. **Setup**: The code starts by importing necessary libraries, including Streamlit, OS, and datetime. It also defines directories for knowledge bases and logs.
2. **Profiles**: The code defines a dictionary `PROFILES` that contains information about each organization, including its name, role, tone, logo, and knowledge base file path.
3. **Streamlit page setup**: The code sets up the Streamlit page with a title, icon, and layout.
4. **CSS styling**: The code includes CSS styling to create a chat-like interface with a sidebar and a chat container.
5. **Sidebar**: The code creates a sidebar with a selectbox to choose the organization type. It also displays the organization's name, role, and logo.
6. **Chat logic**: The code initializes the chatbot agent and sets up the chat container. It also handles user input and generates responses from the chatbot agent.
7. **Chat container**: The code creates a chat container that displays the conversation between the user and the chatbot.
8. **Chat input**: The code creates a chat input field where users can type their messages.
9. **Logging**: The code logs each conversation to a file in the logs directory.

To run this code, you'll need to have Streamlit installed and create a `kb` directory with knowledge base files for each organization (e.g., `hospital_kb.txt`, `hotel_kb.txt`, etc.). You'll also need to create a `logs` directory to store the conversation logs.

Here's an example of how you can create a knowledge base file for the hospital:

`hospital_kb.txt`:
```
What are your working hours?
Our working hours are 9 AM to 6 PM, Monday to Saturday.

How can I book an appointment?
You can book an appointment online or by calling +91-9876543210.

What departments do you have?
We have Cardiology, Neurology, Pediatrics, and Orthopedics departments.
```
This knowledge base file contains questions and answers that the chatbot can use to respond to user queries.

Once you have the knowledge base files and the logs directory set up, you can run the Streamlit application using `streamlit run your_app.py` (replace `your_app.py` with the actual file name). This will launch the chatbot interface, and you can start interacting with it by selecting the organization type and typing your messages.
